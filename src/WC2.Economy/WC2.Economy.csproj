<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WC2.Economy</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)../../libs/CS2MenuManager.dll')">
    <DefineConstants>$(DefineConstants);HAS_CS2MENUMANAGER</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../../libs/CS2MenuManager.dll')">
    <Reference Include="CS2MenuManager">
      <HintPath>$(MSBuildThisFileDirectory)../../libs/CS2MenuManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.*" />
    <ProjectReference Include="../WC2.API/WC2.API.csproj" />
    <ProjectReference Include="../WC2.Shared/WC2.Shared.csproj" />
  </ItemGroup>
</Project>
